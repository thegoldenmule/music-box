#!/usr/bin/env python3
"""Entry point for the release tool. See `Tools/ship --help`.

Deliberately a script and not an installed package: a release tool that needs
installing before it can tell you why your release is broken has already lost.
`Tools/ship doctor` works on a fresh clone with nothing but Xcode present.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from shipkit.cli import main  # noqa: E402  (path must be set first)

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
