{
  "checks": {
    "claude": {
      "novelty": "changed-file",
      "tools": {
        "ts/async/floating-promises": "block",
        "ts/types/loopholes": {
          "level": "block",
          "minSeverity": "warning"
        },
        "ts/comments/llm-tells": "warn",
        "ts/comments/long": "warn",
        "swift/comments/llm-tells": "warn",
        "swift/comments/long": "warn"
      }
    },
    "commit": {
      "novelty": "changed-lines",
      "tools": {
        "ts/async/floating-promises": "block",
        "ts/graph/cycles": "block",
        "ts/dupes/functions": {
          "level": "warn",
          "minSeverity": "warning"
        },
        "ts/comments/long": "warn",
        "ts/comments/llm-tells": "warn",
        "swift/comments/long": "warn",
        "swift/comments/llm-tells": "warn"
      }
    },
    "push": {
      "novelty": "none",
      "tools": {
        "swift/comments/long": "block",
        "swift/comments/llm-tells": "block",
        "swift/comments/stale-refs": "block"
      }
    }
  },
  "swift": {
    "comments": {
      "long": {
        "input": {
          "maxLines": 1,
          "maxChars": 83
        }
      },
      "stale-refs": {
        "ignore": [
          "MusicItemCollection",
          "personalMix",
          "seekingForward",
          "seekingBackward",
          "KidPlayerModel.adoptHandover()",
          "KidPlayerModel.hasEnded",
          "iCloud",
          "CloudKit",
          "secondsPlayed",
          "skip",
          "ForEach"
        ]
      }
    }
  }
}
