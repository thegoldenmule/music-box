.DS_Store
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/
Packages/*/Package.resolved
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
build/
*.xcodeproj/project.xcworkspace/

# SQLite sidecars beside checked-in store fixtures
*.sqlite-wal
*.sqlite-shm

# Python bytecode from Tools/ship. Machine- and version-specific, and 23 of
# them were committed once already.
__pycache__/
*.pyc

# App Store Connect API credentials, written by `Tools/ship auth`. The rule is
# here rather than added on first use because the window that matters is the one
# before anybody runs anything.
.env

# A downloaded App Store Connect key, in case one is ever saved here by mistake.
# `Tools/ship auth import` copies it to ~/private_keys and says to delete the
# original, but Apple issues a .p8 exactly once and a committed one is disclosed.
*.p8
