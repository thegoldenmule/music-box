<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A partial Info.plist. GENERATE_INFOPLIST_FILE stays on, so everything
	     expressible as an INFOPLIST_KEY_* build setting still merges in here at
	     build time and is not duplicated below.

	     UIBackgroundModes is not one of those keys. Xcode accepts
	     INFOPLIST_KEY_UIBackgroundModes as a setting and then silently drops it
	     from the generated plist — background audio normally arrives via the
	     capability editor writing a file exactly like this one. Verified by
	     reading the key back out of the built app, which is the only way to
	     catch it: nothing fails to compile. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- Where a CKSyncEngine's change notifications land. A parent's deny
		     that only arrives when the child next launches the app is not the
		     safety story this design describes. -->
		<string>remote-notification</string>
	</array>

	<!-- Declares that this app can be the target of a CloudKit share
	     invitation. Without it the system does not offer the app when a share
	     link is opened, and the second parent's first ten minutes — the
	     feature's front door — simply do not happen. -->
	<key>CKSharingSupported</key>
	<true/>

	<!-- Answers the export compliance question once, at build time. Without it every
	     upload lands in TestFlight as 'Missing Compliance' and is untestable until
	     somebody answers the same question by hand, per build. This app's only
	     cryptography is HTTPS, which is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
